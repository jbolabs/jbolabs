{
  "name": "jbolabs",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
      "@astrojs/check": "0.9.10",
      "@astrojs/cloudflare": "14.3.3",
      "@astrojs/react": "6.0.6",
      "@base-ui/react": "1.8.0",
      "@cloudflare/workers-types": "5.20261005.1",
      "@effect/platform-bun": "4.0.6",
      "@effect/platform-node": "4.0.6",
      "@effect/vitest": "4.0.6",
      "@emnapi/core": "1.11.3",
      "@emnapi/runtime": "1.11.3",
      "@lucide/astro": "1.52.0",
      "@tailwindcss/vite": "4.3.3",
      "@types/bun": "1.4.2",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.7",
      "alchemy": "2.0.0-beta.84",
      "astro": "7.3.5",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "effect": "4.0.6",
      "lucide-react": "1.52.0",
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "tailwind-merge": "3.7.0",
      "tailwindcss": "4.3.3",
      "tw-animate-css": "1.4.0",
      "typescript": "7.0.2",
      "vitest": "5.0.3",
      "wrangler": "4.147.0",
      "@alchemy.run/cloudflare": "2.0.0-beta.84",
      "@alchemy.run/github": "2.0.0-beta.84",
      "@alchemy.run/infisical": "2.0.0-beta.84"
    },
    "catalogs": {
      "typescript-api": {
        "typescript": "6.0.3"
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "bun run sync && ultracite check --max-warnings 0 && bun run check:copy && bun run check:locality",
    "check:copy": "bun packages/config/check-copy.ts",
    "check:locality": "bun packages/config/check-locality.ts",
    "fix": "bun run sync && ultracite fix",
    "lint:ci": "bun run sync && ultracite check --max-warnings 0 --format github",
    "typecheck": "turbo run typecheck //#typecheck:root",
    "test": "turbo run test //#test:root",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "test:root": "vitest run",
    "ci": "bun run check && turbo run typecheck test //#typecheck:root //#test:root",
    "sync": "turbo run sync --output-logs=errors-only",
    "app": "bun packages/control-app/src/cli.ts",
    "dev": "bun packages/control-app/src/cli.ts dev",
    "smoke": "bun packages/control-app/src/cli.ts smoke",
    "setup:worktree": "bun scripts/setup-worktree.ts",
    "setup:infisical": "alchemy profile edit --config stacks/studio.ts --add Infisical --method universal-auth --set clientId=env:INFISICAL_CLIENT_ID --set clientSecret=env:INFISICAL_CLIENT_SECRET --no-input",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || true",
    "mailflare:build": "cd mailflare && npm ci --no-audit --no-fund && npm run build",
    "plan:studio": "alchemy plan stacks/studio.ts --stage shared",
    "deploy:studio": "alchemy deploy stacks/studio.ts --stage shared",
    "plan:mail": "bun run mailflare:build && alchemy plan stacks/mail.ts --stage prod",
    "deploy:mail": "bun run mailflare:build && alchemy deploy stacks/mail.ts --stage prod",
    "plan:github": "alchemy plan stacks/github.ts --stage ci",
    "deploy:github": "alchemy deploy stacks/github.ts --stage ci"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/github": "catalog:",
    "@alchemy.run/infisical": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@jakebodea/cloudflare-kit": "workspace:*",
    "@jakebodea/config": "workspace:*",
    "@jakebodea/control-app": "workspace:*",
    "@shadcn/lint": "0.2.0",
    "@types/bun": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "eslint-plugin-sonarjs": "4.2.2",
    "lefthook": "2.1.17",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-plugin-react-doctor": "0.9.17",
    "oxlint-tsgolint": "7.0.2003",
    "playwright-core": "1.63.0",
    "turbo": "2.11.7",
    "typescript": "catalog:typescript-api",
    "ultracite": "7.12.4",
    "vitest": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.6"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@alchemy.run/cloudflare@2.0.0-beta.84": "patches/@alchemy.run%2Fcloudflare@2.0.0-beta.84.patch"
  }
}
