---
/**
 * Client sites on `/work`: one row each, the home page in a browser frame with
 * the phone view overlapping it, and the story beside it. Rows alternate sides.
 */
import { ArrowRight, ArrowUpRight } from "@lucide/astro";

import type { WorkSection } from "@/content/types";

interface Props {
  value: WorkSection;
}

const { value } = Astro.props;
const shadow = "shadow-[0_1px_2px_oklch(0.2_0.02_265/0.04),0_24px_48px_-28px_oklch(0.2_0.02_265/0.24)]";
---

<section class="container-page pb-12 sm:pb-16">
  <ol class="space-y-20 sm:space-y-28 lg:space-y-32">
    {value.items.map((item, index) => {
      const flipped = index % 2 === 1;
      const host = item.href === undefined ? undefined : new URL(item.href).hostname;
      return (
        <li class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
          <div class:list={["relative pb-[14%] lg:col-span-7", flipped ? "pl-[9%] lg:order-last" : "pr-[9%]"]}>
            <figure class:list={["overflow-hidden rounded-2xl border border-border bg-card", shadow]}>
              <div class="flex items-center gap-1.5 border-b border-border bg-muted/60 px-4 py-2.5" aria-hidden="true">
                <span class="size-2 rounded-full bg-foreground/15"></span>
                <span class="size-2 rounded-full bg-foreground/15"></span>
                <span class="size-2 rounded-full bg-foreground/15"></span>
                <span class="mx-auto truncate rounded-full bg-background/80 px-3 py-0.5 font-mono text-[0.65rem] text-muted-foreground">{host ?? "launching soon"}</span>
                <span class="w-[1.875rem]"></span>
              </div>
              <img src={item.screenshots.desktop} alt={`The ${item.name} home page on a desktop`} width="1200" height="750" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover object-top" />
            </figure>
            <figure class:list={["absolute bottom-0 w-[24%] overflow-hidden rounded-[clamp(0.9rem,2.6vw,1.75rem)] border-[clamp(3px,0.6vw,6px)] border-[oklch(0.2_0.01_265)] bg-[oklch(0.2_0.01_265)] ring-1 ring-border", shadow, flipped ? "left-0" : "right-0"]}>
              <img src={item.screenshots.phone} alt={`The ${item.name} home page on a phone`} width="600" height="1299" loading="lazy" decoding="async" class="aspect-[390/844] w-full rounded-[clamp(0.6rem,2vw,1.4rem)] object-cover object-top" />
            </figure>
          </div>
          <div class="lg:col-span-5">
            <p class="font-mono text-xs tracking-wide text-muted-foreground uppercase">
              <span class="text-foreground">{String(index + 1).padStart(2, "0")}</span>
              <span class="mx-2 text-border" aria-hidden="true">/</span>
              {item.kind}
            </p>
            <h2 class="mt-3 text-2xl font-medium tracking-[-0.02em] sm:text-3xl">{item.name}</h2>
            <p class="mt-4 max-w-md leading-relaxed text-muted-foreground">{item.body}</p>
            <ul class="mt-6 flex max-w-md flex-wrap gap-2" aria-label={`What the ${item.name} site does`}>
              {item.highlights.map((highlight) => (
                <li class="rounded-full border border-border px-3 py-1 text-sm text-muted-foreground">{highlight}</li>
              ))}
            </ul>
            {item.href === undefined ? (
              <p class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-muted-foreground">
                <span class="size-1.5 rounded-full bg-signal" aria-hidden="true"></span>
                Launching soon
              </p>
            ) : (
              <a href={item.href} class="mt-6 inline-flex items-center gap-1 font-medium underline-offset-4 hover:underline">Visit {host}<ArrowUpRight class="nudge-up-right size-4" aria-hidden="true" /></a>
            )}
          </div>
        </li>
      );
    })}
  </ol>
  {value.aside && (
    <p class="mt-20 border-t border-border pt-8 text-muted-foreground sm:mt-28">
      {value.aside.text}
      <a href={value.aside.link.href} class="ml-1 inline-flex items-center gap-1 font-medium text-foreground underline-offset-4 hover:underline">{value.aside.link.label}<ArrowRight class="nudge-right size-4" aria-hidden="true" /></a>
    </p>
  )}
</section>
